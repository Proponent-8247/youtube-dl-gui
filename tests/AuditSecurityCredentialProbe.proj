<?xml version="1.0" encoding="utf-8"?>
<!--
  Security acceptance fixture, NOT a production project.
  Invocation (Windows Actions; no repo-write token):
    msbuild tests/AuditSecurityCredentialProbe.proj /t:Probe /nologo /v:minimal

  Simulates an untrusted project using MSBuild Exec to attempt a repository push.
  --dry-run MUST prevent changing GitHub refs even if a regression is introduced.
  The project first verifies it runs inside the checked-out repository.
  A non-zero push alone is insufficient: stderr must show an authorization failure;
  the companion PowerShell step performs that assertion.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Probe">
  <Target Name="Probe">
    <Error Condition="'$(GITHUB_WORKSPACE)' == ''" Text="No GitHub Actions workspace available." />
    <Exec WorkingDirectory="$(GITHUB_WORKSPACE)"
          Command="git rev-parse --is-inside-work-tree" />
    <Exec WorkingDirectory="$(GITHUB_WORKSPACE)"
          Command="git -c credential.interactive=never push --dry-run origin HEAD:refs/heads/security-audit-write-probe"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="AttemptExitCode" />
    </Exec>
    <Error Condition="'$(AttemptExitCode)' == '0'"
           Text="SECURITY FAILURE: Build-time code was able to authenticate a GitHub repository write." />
    <Message Importance="high" Text="Hostile MSBuild dry-run push refused, exit $(AttemptExitCode)." />
  </Target>
</Project>
